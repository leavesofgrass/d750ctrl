#!/usr/bin/env python3
"""d750d-kuma: tell Uptime Kuma whether d750d, the TM-D750 and xara are well.

Run once a minute by the user timer d750d-kuma.timer. Push URLs come from ~/.config/kuma-push-url-d750d and
~/.config/kuma-push-url-xara: each holds the URL Uptime Kuma shows for a Push monitor, on one line. Each push is
skipped while its file is missing.

The radio switched off is a normal state, at night for one: both its USB devices are then gone. While it is off,
the radio link and xara report up, with "radio off", so nothing alarms; with the radio on, a radio that does not
answer, or xara not answering, reports down with the reason.
Asks d750d's command port for its state and the radio's ID: one CAT command a minute.
Written Wednesday, November 11, 2026.
"""
import glob
import os
import socket
import time
import urllib.parse
import urllib.request

PUSH_D750D = os.path.expanduser("~/.config/kuma-push-url-d750d")
PUSH_XARA = os.path.expanduser("~/.config/kuma-push-url-xara")
OFF_SINCE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "d750-radio-off-since")


def radio_on_usb(vendor="2166"):
    for f in glob.glob("/sys/bus/usb/devices/*/idVendor"):
        try:
            if open(f).read().strip() == vendor:
                return True
        except OSError:
            pass
    return False


def off_words():
    """'radio off since HH:MM', remembering when it was first seen off."""
    try:
        since = float(open(OFF_SINCE).read())
    except (OSError, ValueError):
        since = time.time()
        try:
            open(OFF_SINCE, "w").write(str(since))
        except OSError:
            pass
    return "radio off since " + time.strftime("%H:%M", time.localtime(since))


def ask(line):
    with socket.create_connection(("127.0.0.1", 4533), 5) as s:
        s.settimeout(5)
        s.sendall((line + "\n").encode())
        return s.makefile(encoding="utf-8", errors="replace").readline().strip()


def port_open(port):
    try:
        with socket.create_connection(("127.0.0.1", port), 3):
            return True
    except OSError:
        return False


def push(path, up, msg):
    try:
        base = open(path, encoding="utf-8").read().strip()
    except OSError:
        return
    url = base.split("?", 1)[0] + "?" + urllib.parse.urlencode({"status": "up" if up else "down", "msg": msg, "ping": ""})
    try:
        urllib.request.urlopen(url, timeout=10).read()
    except Exception:
        pass


def main():
    on = radio_on_usb()
    if on:
        try:
            os.unlink(OFF_SINCE)
        except OSError:
            pass
    # d750d and the radio
    try:
        state = ask("state")
        ident = ask("ID")
        if ident.startswith("ID TM-D750"):
            link = (True, "radio answers, " + state.split(";")[0] + ("; keyed now" if "; keyed" in state else ""))
        elif not on:
            link = (True, off_words() + "; d750d is up and waiting for it")
        else:
            link = (False, "d750d is up and the radio is on USB, but it does not answer: " + (ident or "no answer"))
    except OSError as e:
        link = (False, "d750d does not answer on port 4533: " + (e.strerror or str(e)))
    push(PUSH_D750D, *link)
    # xara: its command port and web page; it waits for the radio's sound card, so it is down while the radio is off
    cmd, web = port_open(8300), port_open(8310)
    if cmd and web:
        xara = (True, "xara answers on 8300 and 8310")
    elif not on:
        xara = (True, off_words() + "; xara waits for its sound card")
    else:
        xara = (False, "xara does not answer on " + " and ".join(p for p, ok in (("8300", cmd), ("8310", web)) if not ok))
    push(PUSH_XARA, *xara)


if __name__ == "__main__":
    main()
