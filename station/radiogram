ADDRESSES = f"{HOME}/.config/xarachat/addresses.txt"
CHAT_CONF = f"{HOME}/.config/xarachat/xarachat.conf"
D750_CONF = os.path.join(os.environ.get("D750_CONF_DIR") or f"{HOME}/.config/d750ctrl", "d750ctrl.conf")
CONF_KEYS = ("station", "place", "signature", "precedence", "hx", "send_to", "next", "places", "stations", "signatures")
STORE = f"{HOME}/.local/share/xarachat/radiograms"
LOG = f"{STORE}/traffic-log.txt"

