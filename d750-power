#!/usr/bin/env python3
"""d750-power: power cycle the TM-D750 through the relay on the LattePanda's Leonardo.

  d750-power status        is the radio powered
  d750-power cycle [N]     radio off for N seconds (3 to 60, default 10), then on again by itself
  d750-power on            power back on now
  d750-power id            the relay sketch's version, pin and polarity

Talks to relay/d750-relay/d750-relay.ino on the Leonardo. Exit 0 Pass, 1 Fail, 2 usage.
The port is opened at 9600 baud, never 1200, which would put the Leonardo in its bootloader.
Written Wednesday, November 11, 2026.
"""
import os
import sys
import time

PORT = os.environ.get("D750_RELAY_PORT", "/dev/serial/by-id/usb-Unknown_LattePanda_Leonardo-if00")


def main(argv):
    if not argv or argv[0] not in ("status", "cycle", "on", "id"):
        print(__doc__.strip())
        return 2
    cmd = " ".join(argv[:2])
    try:
        import serial
        s = serial.Serial(PORT, 9600, timeout=2)
    except Exception as e:
        print(f"Fail: the relay's port {PORT} cannot be opened: {e}")
        return 1
    with s:
        time.sleep(0.2)
        s.reset_input_buffer()
        s.write((cmd + "\n").encode())
        reply = s.readline().decode("utf-8", "replace").strip()
    if not reply:
        print("Fail: no answer from the relay. Is d750-relay.ino on the Leonardo?")
        return 1
    print(reply)
    return 0 if reply.startswith(("OK", "Pass", "Note", "d750-relay")) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
