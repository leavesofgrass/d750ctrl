# d750-aprs settings: ~/.config/d750ctrl/aprs.conf. key = value; # starts a comment.

# Your call sign with the SSID this station beacons as.
call = N0CALL-2
# The TNC's serial port, from udev/60-d750ctrl.rules. KISS comes out here with radio menu 983 on
# USB (Main Unit) and the TNC in KISS mode.
tnc = /dev/d750-tnc
# The port's DTR and RTS lines: raised or low.
tnc_lines = raised

# The home position, in decimal degrees: north and east positive.
lat =
lon =
# APRS symbol, table then code: /- is a house.
symbol = /-
comment = home station
# Digipeater path, and minutes between beacons.
path = WIDE1-1,WIDE2-1
interval = 30

# Nothing transmits until this is on: beacons, messages, acknowledgements, KISS programs.
# Change it with: d750-aprs transmit on
transmit = off

# Where KISS programs can connect, space separated host:port.
kiss_listen = 127.0.0.1:8001
# Distances and speeds: mi or km.
units = mi

# Receive-only iGate: rx passes what the radio hears to APRS-IS, off does not. Nothing from the
# internet is ever transmitted. Change it with: d750-aprs igate on
igate = off
aprsis_server = noam.aprs2.net:14580
# The APRS-IS passcode for your call. Keep this file readable by you only.
aprsis_pass =
# on also sends the home beacon to APRS-IS directly, beside the radio beacon.
aprsis_beacon = off
