# d750ctrl settings. Copy to ~/.config/d750ctrl/d750ctrl.conf and fill in. Lines starting with # are ignored.
# Your call sign, used for the CQ frame sent through xara.
mycall = N0CALL
# varac = xarachat    what o opens for VarAC chat: xarachat speaking VarAC's framing (default), or openslot
# The radio's Bluetooth address, for the Bluetooth checks in d750 doctor and d750 fixup. Leave empty if unpaired.
bluetooth =
# d750d's ports: rigctld-style PTT for xara, and the command line protocol for the d750 tools.
ptt_port = 4532
cmd_port = 4533
# How often the rig screen reads the radio, in seconds. Every status_seconds it reads everything, about 15 CAT
# commands; every busy_seconds only the busy flags of both bands, 2 commands. busy_seconds = 0 reads them with
# the rest. A change made from the screen is read back at once either way.
status_seconds = 2
busy_seconds = 1
# d750ctrl runs inside tmux when it is installed, each tool in a window of its own. workspace = no turns that off.
workspace = yes
# Keys tmux binds while the workspace runs: back to the rig screen, and step to the next window. tmux key names.
rig_key = F9
next_key = F12
# The views and looks of the rig screen. Each line below is a comment, so a fresh install uses the defaults.
# view: face (both bands side by side), list (one control a row, built for speech and Braille) or compact.
# view = face
# theme: dark, blue or mono (no color). A NO_COLOR variable that is not empty also means mono.
# theme = dark
# digits: big (large frequency digits, when the window is tall enough) or plain.
# digits = big
# live_meters: how often the busy lamps are read. auto reads them every busy_seconds in the wide face only;
# yes does so in every view; no reads them with each full read. Older words on and off also work.
# live_meters = auto
# announce: message puts what changed in the message row; cursor leaves that row for refusals and events.
# announce = message
# Key changes go in a [keys] section, and it must be the last thing in the file. One line for each action:
# the action's name, an equals sign, then up to 4 keys. d750ctrl --check lists the names and the keys in force.
# [keys]
# quit = Q
# unkey = F5
# act-power = P
